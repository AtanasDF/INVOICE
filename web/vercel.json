{
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/notifications/check",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/recurring-invoices/generate",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/reminders/send",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/notifications/weekly",
      "schedule": "0 7 * * 1"
    }
  ]
}
