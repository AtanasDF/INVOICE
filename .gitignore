
# macOS
.DS_Store

# real documents used for scanner testing; never commit
/test-docs/

# iCloud Desktop sync makes "name 2.ext" copies of files; never commit them.
* 2.*

# Harness leftovers: Chrome profiles, generated clips and compiled logic are
# all disposable; only the source in harness/ is kept.
harness/node_modules
harness/profile-*/
harness/downloads-*/
harness/profile/
harness/gen/
harness/*.mjpeg
harness/*.log
# One-off probes written to answer a single question during a session --
# _titles.mjs, _lg.mjs and their like. Two got swept into a commit by a
# `git add -A` on 2026-09-24; a real suite is called test-*.mjs.
harness/_*.mjs

# Finished feature branches' worktrees: 5.4GB of copies of this repo, every
# line of it already in git history. The launch config beside them is kept.
.claude/worktrees/

# Odd-file fixtures for test-odd-files: the 23MB photo is regenerated by
# harness/gen-odd-files.sh, and the .pdf files are unpacked from their
# .b64 at test time. The small ones are kept.
harness/fixtures/ten-mb.jpg
harness/fixtures/*.pdf

# Screenshots and downloads the suites regenerate on every run. The
# fixtures/ inputs are kept; these outputs are not.
harness/*.png
# PDFs a suite saves while checking a download (test-quotes-ux writes one).
# fixtures/*.pdf above covers the inputs; these are outputs.
harness/*.pdf
harness/downloads/
harness/gen-bench/
harness/bench-docs/
web/.vercel/
# Testers' words and email addresses; the repo is public, so this stays on the Mac.
notes/feedback-inbox.md
harness/uploads/
harness/multi/

# The printable pile is regenerated by gen-test-documents.mjs in seconds; the
# answer key and the index are kept because they are read and annotated.
harness/test-documents/documents.pdf
harness/test-documents/documents.html
