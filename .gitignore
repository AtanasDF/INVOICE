
# macOS
.DS_Store

# real documents used for scanner testing; never commit
/test-docs/

# iCloud Desktop sync makes "name 2.ext" copies of files; never commit them.
* 2.*

# Harness leftovers: Chrome profiles, generated clips and compiled logic are
# all disposable; only the source in harness/ is kept.
harness/node_modules
harness/profile-*/
harness/gen/
harness/*.mjpeg
harness/*.log

# Finished feature branches' worktrees: 5.4GB of copies of this repo, every
# line of it already in git history. The launch config beside them is kept.
.claude/worktrees/

# Odd-file fixtures for test-odd-files: the 23MB photo is regenerated by
# harness/gen-odd-files.sh, and the .pdf files are unpacked from their
# .b64 at test time. The small ones are kept.
harness/fixtures/ten-mb.jpg
harness/fixtures/*.pdf

# Screenshots and downloads the suites regenerate on every run. The
# fixtures/ inputs are kept; these outputs are not.
harness/*.png
harness/downloads/
harness/gen-bench/
harness/bench-docs/
